{
  "info": {
    "_postman_id": "6d2f0c3b-5f0c-4a0a-9d6a-8d8d6e8f7a11",
    "name": "Valizu Backend API",
    "description": "Postman collection aligned with the Valizu Backend OpenAPI 3.0.3 schema. The collection contains the documented API operations and uses the documented X-User-Id and Idempotency-Key headers. The Users endpoint can be run first to discover an existing user and populate the collection userId variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8081" },
    { "key": "userId", "value": "" },
    { "key": "tripId", "value": "" },
    { "key": "bagId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "bagItemId", "value": "" },
    { "key": "copiedTripId", "value": "" },
    { "key": "idempotencyKey", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Operations tagged Health in the OpenAPI schema.",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/health",
            "description": "operationId: getHealth"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "description": "Operations tagged Users in the OpenAPI schema.",
      "item": [
        {
          "name": "GET /users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "description": "operationId: listUsers. Returns the users available in the case-study dataset."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('Every user has an id', () => {",
                  "  body.data.forEach((user) => pm.expect(user.id).to.be.a('string'));",
                  "});",
                  "pm.test('Every user has an email', () => {",
                  "  body.data.forEach((user) => pm.expect(user.email).to.be.a('string'));",
                  "});",
                  "if (body.data.length > 0 && !pm.collectionVariables.get('userId')) {",
                  "  pm.collectionVariables.set('userId', body.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trips",
      "description": "Operations tagged Trips in the OpenAPI schema.",
      "item": [
        {
          "name": "GET /trips",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": "{{baseUrl}}/trips",
            "description": "operationId: listTrips. Returns all trips belonging to the authenticated user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('All returned trips belong to the authenticated user', () => {",
                  "  const userId = pm.variables.get('userId');",
                  "  body.data.forEach((trip) => pm.expect(trip.userId).to.eql(userId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /trips/{tripId}/copy",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "url": "{{baseUrl}}/trips/{{tripId}}/copy",
            "description": "operationId: copyTrip. Creates a copy of a trip including its bags and bag items."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('idempotencyKey')) {",
                  "  pm.environment.set('idempotencyKey', 'postman-copy-' + pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data', () => pm.expect(body.data).to.be.an('object'));",
                  "pm.test('Copied trip has an id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.test('Copied trip has a new id', () => pm.expect(body.data.id).to.not.eql(pm.variables.get('tripId')));",
                  "pm.collectionVariables.set('copiedTripId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /trips/{tripId}/copy - same Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "url": "{{baseUrl}}/trips/{{tripId}}/copy",
            "description": "Repeat the documented copyTrip operation with the same Idempotency-Key. The OpenAPI description states that the same result is returned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Retry returns original copied trip', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('copiedTripId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /trips/{tripId}/copy - missing authentication",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "postman-unauthenticated-{{$guid}}" }
            ],
            "url": "{{baseUrl}}/trips/{{tripId}}/copy",
            "description": "Negative test for the documented 401 UNAUTHENTICATED response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error code is UNAUTHENTICATED', () => pm.expect(pm.response.json().error).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bags",
      "description": "Operations tagged Bags in the OpenAPI schema.",
      "item": [
        {
          "name": "GET /trips/{tripId}/bags",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": "{{baseUrl}}/trips/{{tripId}}/bags",
            "description": "operationId: listBags. Returns all bags belonging to the specified trip."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('All returned bags belong to requested trip', () => {",
                  "  const tripId = pm.variables.get('tripId');",
                  "  body.data.forEach((bag) => pm.expect(bag.tripId).to.eql(tripId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /trips/{tripId}/bags",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/trips/{{tripId}}/bags",
            "description": "operationId: createBag",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carry-on\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains bag data', () => pm.expect(body.data).to.be.an('object'));",
                  "pm.test('Bag has an id', () => pm.expect(body.data.id).to.be.a('string'));",
                  "pm.test('Bag belongs to requested trip', () => pm.expect(body.data.tripId).to.eql(pm.variables.get('tripId')));",
                  "pm.collectionVariables.set('bagId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /bags/{bagId}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/bags/{{bagId}}",
            "description": "operationId: updateBag",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Checked luggage\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains bag data', () => pm.expect(body.data).to.be.an('object'));",
                  "pm.test('Bag id is unchanged', () => pm.expect(body.data.id).to.eql(pm.variables.get('bagId')));",
                  "pm.test('Bag name was updated', () => pm.expect(body.data.name).to.eql('Checked luggage'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Items",
      "description": "Operations tagged Items in the OpenAPI schema.",
      "item": [
        {
          "name": "GET /items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": "{{baseUrl}}/items",
            "description": "operationId: listItems. Returns all items belonging to the authenticated user."
          },
         "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('All returned items belong to the authenticated user', () => {",
                  "  const userId = pm.variables.get('userId');",
                  "  body.data.forEach((item) => pm.expect(item.userId).to.eql(userId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /bags/{bagId}/items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              }
            ],
            "url": "{{baseUrl}}/bags/{{bagId}}/items",
            "description": "operationId: listBagItems. Returns all items currently contained in the specified bag."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains data array', () => pm.expect(body.data).to.be.an('array'));",
                  "pm.test('All returned bag items belong to requested bag', () => {",
                  "  const bagId = pm.variables.get('bagId');",
                  "  body.data.forEach((bagItem) => pm.expect(bagItem.bagId).to.eql(bagId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /bags/{bagId}/items",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/bags/{{bagId}}/items",
            "description": "operationId: addItemToBag",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{itemId}}\",\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response contains bag item data', () => pm.expect(body.data).to.be.an('object'));",
                  "pm.test('Requested item was added', () => pm.expect(body.data.itemId).to.eql(pm.variables.get('itemId')));",
                  "pm.test('Quantity is at least 1', () => pm.expect(body.data.quantity).to.be.at.least(1));",
                  "pm.collectionVariables.set('bagItemId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /bags/{bagId}/items/{itemId}",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": "{{baseUrl}}/bags/{{bagId}}/items/{{itemId}}",
            "description": "operationId: removeItemFromBag"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));",
                  "pm.test('Response body is empty', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
