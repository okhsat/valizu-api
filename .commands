> mkdir -p src
> cat > src/main.ts <<'EOF'
import express from 'express';

const app = express();

app.use(express.json());

app.get('/health', (_req, res) => {
  res.json({
    status: 'ok',
  });
});

const port = Number(process.env.API_PORT ?? 3000);

app.listen(port, () => {
  console.log(`Valizu API listening on port ${port}`);
});
EOF
